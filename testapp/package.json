{
  "name": "testapp",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "setup": "mkdir -p packages && ln -sfn ../../ ./packages/meteor-autoform",
    "lint": "node_modules/@biomejs/biome/bin/biome check ../*.js",
    "lint:fix": "node_modules/@biomejs/biome/bin/biome check  --write ../*.js",
    "test": "METEOR_PACKAGE_DIRS='../' TEST_BROWSER_DRIVER=puppeteer TEST_SERVER=0 meteor test-packages --once --raw-logs --driver-package meteortesting:mocha ../",
    "test:watch": "METEOR_PACKAGE_DIRS='../' TEST_BROWSER_DRIVER=puppeteer TEST_SERVER=0 TEST_WATCH=1 meteor test-packages --raw-logs --driver-package meteortesting:mocha ../",
    "test:browser": "METEOR_PACKAGE_DIRS='../' TEST_SERVER=0 TEST_WATCH=1 meteor test-packages --raw-logs --driver-package meteortesting:mocha ../"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "meteor-node-stubs": "^1.2.25",
    "puppeteer": "^24.37.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@biomejs/biome": "^2.3.15",
    "chai": "^6.2.2",
    "sinon": "^21.0.1",
    "snazzy": "^9.0.0",
    "standardx": "^7.0.0"
  },
  "babel": {},
  "standardx": {
    "globals": [
      "AutoForm",
      "arrayTracker",
      "globalDefaultTemplate",
      "defaultTypeTemplates",
      "deps"
    ],
    "ignore": [
      "**/testapp/"
    ]
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "allowImportExportEverywhere": false
    },
    "rules": {
      "brace-style": [
        "error",
        "stroustrup",
        {
          "allowSingleLine": true
        }
      ]
    }
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js"
    }
  }
}
